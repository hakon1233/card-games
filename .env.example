# Supabase — used only for sign-in. The games and their tests run without it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PartyKit real-time server. Leave as-is for `npx partykit dev`.
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Public origin of the app, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret between the Next.js server and the PartyKit room server: the
# server signs room tokens with it, the room verifies them. A random string of
# at least 32 characters (e.g. `openssl rand -hex 32`). Locally, `partykit dev` reads it from
# .env.local too; a deployed PartyKit project needs it set separately
# (`npx partykit env add ROOM_TOKEN_SECRET`). Required for multiplayer rooms;
# rooms refuse to open without it.
ROOM_TOKEN_SECRET=
